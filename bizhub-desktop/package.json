{
  "name": "bizhub-desktop",
  "version": "1.0.0",
  "description": "BizHub Desktop - Universal Business Management Suite",
  "main": "electron/main.js",
  "author": "Davis Okoth",
  "publisher": "Davis Okoth",
  "license": "ISC",
  "scripts": {
    "generate-assets": "node electron/scripts/generate-assets.js",
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "node-thermal-printer": "^4.4.2",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "co.ke.bizhub.desktop",
    "productName": "BizHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "publisherName": "Davis Okoth"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BizHub"
    }
  }
}