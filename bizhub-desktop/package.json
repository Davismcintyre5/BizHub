{
  "name": "bizhub-desktop",
  "version": "1.0.1",
  "description": "BizHub Desktop - Universal Business Management Suite",
  "main": "electron/main.js",
  "author": "Davis Okoth",
  "publisher": "Davis Okoth",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-assets": "node electron/scripts/generate-assets.js",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder --win --mac --linux",
    "electron:publish:win": "vite build && electron-builder --win --publish always",
    "electron:publish:all": "vite build && electron-builder --win --mac --linux --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "lucide-react": "^0.441.0",
    "node-thermal-printer": "^4.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.45",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "co.ke.bizhub.desktop",
    "productName": "BizHub",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Davismcintyre5",
      "repo": "docusoft-files",
      "releaseType": "release"
    },
"win": {
  "target": "nsis",
  "icon": "assets/icon-256.png",
  "publisherName": "Davis Okoth"
},
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BizHub"
    }
  }
}