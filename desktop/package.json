{
  "name": "bizhub-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BizHub Desktop — Business Management for Kenyan SMEs",
  "main": "electron/main.js",
  "author": {
    "name": "Davis Okoth",
    "email": "davismcintyre5@gmail.com.com"
  },
  "publisher": "HDM",
  "owner": "Davis Okoth",
  "company": "HDM",
  "license": "ISC",
 "scripts": {
  "dev": "vite --port 3000",
  "build": "vite build",
  "preview": "vite preview --port 3000",
  "lint": "eslint src --ext .js,.jsx",
  "assets": "node scripts/generate-assets.cjs",
  "electron:start": "electron .",
  "electron:dev": "npm run build && electron .",
  "electron:build": "npm run assets && vite build && electron-builder --publish always",
  "electron:build:win": "npm run assets && vite build && electron-builder --win --publish always",
  "electron:build:local": "npm run assets && vite build && electron-builder --publish never",
  "release:patch": "npm version patch -m \"Release v%s\"",
  "release:minor": "npm version minor -m \"Release v%s\"",
  "release:major": "npm version major -m \"Release v%s\"",
  "release:push": "git push --follow-tags"
},
  "dependencies": {
    "axios": "^1.7.7",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.45",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}